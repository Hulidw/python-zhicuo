# ===== 模型接口（可选）=====
# 留空 = 本地讲解模式：不联网、不产生费用，功能完整可用
# 填写后在 https://platform.deepseek.com/ 创建，只放这里，不要写进前端
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# ===== 服务 =====
PORT=8787
# 0.0.0.0 允许同一局域网手机访问；只想本机用就改成 127.0.0.1
HOST=0.0.0.0
# 允许跨域调用接口的前端地址；线上建议写死为你的域名
ALLOW_ORIGIN=*
# 每个 IP 每分钟最多对话次数
RATE_LIMIT=20
# 模型请求总超时（毫秒）
UPSTREAM_TIMEOUT_MS=120000
# 静态目录，默认 dist；也可指向另一份构建产物
DIST_DIR=dist
